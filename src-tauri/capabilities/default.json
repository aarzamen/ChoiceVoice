{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "ChoiceVoice default capabilities",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "shell:allow-execute",
    "shell:allow-spawn",
    "fs:allow-read-dir",
    "fs:allow-read-file",
    "fs:allow-write-file",
    "fs:allow-create",
    "fs:allow-mkdir",
    "fs:allow-remove",
    "dialog:allow-save"
  ]
}
