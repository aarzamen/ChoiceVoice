#!/usr/bin/env bash
# ChoiceVoice TTS sidecar wrapper — v0.1
# Tauri appends the target-triple suffix; this is the aarch64-apple-darwin variant.
set -euo pipefail

# When launched from a bundled .app, macOS gives us the minimal PATH
# /usr/bin:/bin:/usr/sbin:/sbin — no Homebrew. Prepend the common locations
# where `uv` and `python` live so the rest of this script can find them.
export PATH="/opt/homebrew/bin:/usr/local/bin:$HOME/.local/bin:$HOME/.cargo/bin:$PATH"

# Locate sidecar/ dir relative to this script (works both in dev and bundled)
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"

# Friendly error if uv isn't on PATH at all
if ! command -v uv >/dev/null 2>&1; then
    echo '{"event":"error","stage":"wrapper","message":"uv not found on PATH; install via brew install uv"}' >&1
    exit 127
fi

# Search order:
#   1. CHOICEVOICE_SIDECAR_DIR env var (explicit override)
#   2. Relative to wrapper — works for `cargo tauri dev` (wrapper at
#      src-tauri/target/{debug,release}/, sidecar/ two-three levels up)
#   3. ~/Projects/ChoiceVoice/sidecar — works for the bundled .app on the
#      dev machine where the source still lives. Day-one scope per CLAUDE.md.
for candidate in \
    "${CHOICEVOICE_SIDECAR_DIR:-/nonexistent}" \
    "$SCRIPT_DIR/../../../sidecar" \
    "$SCRIPT_DIR/../../sidecar" \
    "$SCRIPT_DIR/../sidecar" \
    "$SCRIPT_DIR/sidecar" \
    "$HOME/Projects/ChoiceVoice/sidecar"
do
    if [ -d "$candidate/choicevoice_tts" ]; then
        SIDECAR_DIR="$(cd "$candidate" && pwd)"
        break
    fi
done

if [ -z "${SIDECAR_DIR:-}" ]; then
    echo '{"event":"error","stage":"wrapper","message":"Cannot locate choicevoice_tts package"}' >&1
    exit 1
fi

cd "$SIDECAR_DIR"

# First-run: create venv if missing
if [ ! -d ".venv" ]; then
    echo '{"event":"first_run_setup","stage":"venv"}' >&1
    uv venv --python 3.12 >&2
    uv pip install mlx-audio numpy soundfile scipy >&2
fi

exec uv run python -m choicevoice_tts "$@"
